{
  "name": "owndeck",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "mvn -f backend/pom.xml spring-boot:run",
    "dev:frontend": "npm run dev --prefix frontend",
    "test:backend": "mvn -f backend/pom.xml test",
    "build:backend": "mvn -f backend/pom.xml clean package -DskipTests",
    "build": "npm run build --prefix frontend",
    "start:backend": "mvn -f backend/pom.xml spring-boot:run"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
